# PyMon NOC (Go) Environment Configuration
# Copy this file to .env and customize

# REQUIRED: JWT secret key for token signing (min 32 chars)
# If not set, a persistent secret is auto-generated in .pymon_jwt_secret
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars-long

# Optional: Initial/admin password used on first run or `reset-admin`.
# If unset (and config has no strong password), a random one is generated and
# shown ONCE. The password is never stored in cleartext.
# PYMON_ADMIN_PASSWORD=ChangeThisStrongPassword123

# Optional: Override config file path
# Default: config.yml
# CONFIG_PATH=/etc/pymon/config.yml

# Optional: Database path (overrides config value)
# Default: pymon.db
# DB_PATH=/data/pymon.db

# Optional: Data directory for runtime files
# Default: ./
# DATA_DIR=/var/lib/pymon

# Optional: Log directory
# Default: ./pymon.log
# LOG_DIR=/var/log/pymon

# Optional: Allow scraping cloud-metadata endpoints (169.254.169.254, etc.)
# Default: false (SSRF protection ON)
# PYMON_ALLOW_METADATA=true
